#include <reg51.h>

#define SEG_PORT P1

sbit DIG1 = P3^0;
sbit DIG2 = P3^1;

unsigned char seg_code[10] =
{
    0x3F,  // 0
    0x06,  // 1
    0x5B,  // 2
    0x4F,  // 3
    0x66,  // 4
    0x6D,  // 5
    0x7D,  // 6
    0x07,  // 7
    0x7F,  // 8
    0x6F   // 9
};

void delay_ms(unsigned int ms)
{
    unsigned int i, j;

    for(i=0; i<ms; i++)
        for(j=0; j<120; j++);
}

void display_number(unsigned char number)
{
    unsigned char tens, units;

    tens = number / 10;
    units = number % 10;

    DIG1 = 0;
    DIG2 = 0;

    SEG_PORT = seg_code[tens];
    DIG1 = 1;
    delay_ms(5);
    DIG1 = 0;

    SEG_PORT = seg_code[units];
    DIG2 = 1;
    delay_ms(5);
    DIG2 = 0;
}

void main(void)
{
    unsigned char count;
    unsigned int refresh;

    SEG_PORT = 0x00;
    DIG1 = 0;
    DIG2 = 0;

    count = 0;

    while(1)
    {
        for(refresh=0; refresh<50; refresh++)
        {
            display_number(count);
        }

        count++;

        if(count > 99)
        {
            count = 0;
        }
    }
}
